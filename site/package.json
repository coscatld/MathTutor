{
  "name": "mathtutor-site",
  "version": "0.7.1",
  "private": true,
  "description": "MathTutor official website and docs (static export for GitHub Pages)",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node ./scripts/postbuild.mjs",
