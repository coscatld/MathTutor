    {
      "id": "quadratic-inequality",
      "title": "一元二次不等式：取错区间后改正",
      "problem": "x^2-5x+6>0",
      "forbidden_before_solution": [
        "x\\s*<\\s*2\\s*或\\s*x\\s*>\\s*3"
      ],
      "steps": [
        {
          "send": "submit_problem",
          "payload": {
            "text": "x^2-5x+6>0"
          }
        },
        {
          "send": "request_hint",
          "ack": true,
          "expect": {
            "actions": [
              "GIVE_HINT"
            ],
            "no_answer": true,
            "contains": [
              "抛物线开口方向"
            ]
          }
        },
        {
          "send": "send_message",
          "payload": {
            "text": "2<x<3"
          },
          "expect": {
            "actions": [
              "incorrect"
            ],
            "no_answer": true,
            "contains": [
              "区间方向"
            ]
          }
        },
        {
          "send": "send_message",
          "payload": {
            "text": "x<2或x>3"
          },
          "expect": {
            "actions": [
              "correct"
            ]
          }
        }
      ],
      "final": {
        "evidence": {
          "independent": 0,
          "assisted": 2
        }
      }
    },
